# Proveedor predeterminado: WhatsApp Web con QR. Cambiar a cloud para Meta API oficial.
WA_PROVIDER=web
WA_WEB_AUTH_DIR=./data/wa-session
WA_WEB_PRINT_QR=true

# Copiar a .env (no incluir .env en control de versiones)
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/memory.sqlite
ADMIN_TOKEN=CAMBIA_ESTO_CON_UN_SECRETO_LARGO_DE_AL_MENOS_32_CARACTERES
SELF_DISPLAY_NAME=Alex
# El número debe ser internacional, solo cifras. Vacío = no se autoriza ningún contacto.
ALLOWED_CONTACTS=51999999999
# OFF por defecto: todo queda como borrador hasta aprobación explícita.
AUTO_SEND=false

# Servidor LLM local (NO exponer Ollama a Internet)
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=mi-modelo:latest
EMBED_MODEL=embeddinggemma
MODEL_CONTEXT=8192
MODEL_TEMPERATURE=0.35
# Revisión adicional de pertinencia. Aumenta llamadas y latencia a Ollama.
REPLY_REVIEW=true
# Borradores del modelo de estilo por mensaje; el revisor aprueba el más breve que sea coherente (1 = desactivado).
REPLY_CANDIDATES=1
# off: todo pasa por el revisor. shape: aprueba sin revisor las respuestas que no superan la mediana
# de longitud propia del titular y no tienen cifras (heurística; medir antes de activarla).
REVIEW_SHORT_APPROVAL=off
# judgment: veredicto global del revisor. closed: preguntas sí/no (responde, añade hechos, confunde hablantes, tono).
REVIEW_MODE=judgment
# auto: prompt de entrenamiento si el modelo lo declara como SYSTEM (modelos entrenados aquí), reglas si no; rules | training fuerzan uno
REPLY_WRITER_PROMPT=auto
# Decisión semántica del motor de recuperación
SEMANTIC_ROUTER=true
RAG_LLM_RERANK=true
ROUTER_MAX_TOKENS=180
RERANK_MAX_TOKENS=420
AUTO_MEMORY_LEARN=true
AUTO_PROFILE_BUILD=true
# Umbral de recuperación; calibrar con evaluación independiente.
RAG_MIN_SCORE=0.38
MODEL_MAX_TOKENS=220
RAG_TOP_K=5

# Meta WhatsApp Cloud API; no son credenciales de una cuenta personal WhatsApp Web
WA_GRAPH_VERSION=v26.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# Qdrant: índice vectorial de historiales y hechos revisados.
# En Docker, QDRANT_URL se sobreescribe con la dirección del servicio.
MEMORY_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=whatsapp_memory
# Generar un secreto único: openssl rand -hex 32
QDRANT_API_KEY=CAMBIA_ESTE_VALOR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
# Puerto expuesto SOLO en loopback por docker compose
APP_PORT=3000

# Interfaz FastAPI/Swagger local (http://127.0.0.1:8000/docs)
FASTAPI_PORT=8000

# Neo4j: Capa de conocimiento estructurado (GraphRAG)
NEO4J_ENABLED=true
NEO4J_URL=http://127.0.0.1:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=secretpassword

# Laboratorio LangGraph — supervisor/programador: antigravity (CLI agy externa) u ollama (local).
# Con antigravity, agy debe estar instalado y autenticado en el equipo anfitrión.
LAB_AGENT_PROVIDER=antigravity
# Usar IDs exactos mostrados por agy models; ajustar cuando cambie el catálogo.
LAB_SUPERVISOR_MODEL=ID_DEL_MODELO_SUPERVISOR
LAB_PROGRAMMER_MODEL=ID_DEL_MODELO_PROGRAMADOR
LAB_AGY_BIN=agy
# El modelo OBJETIVO sigue en Ollama local. El JUEZ puede ser local u opcionalmente NVIDIA NIM.
# Para elegir NIM remoto, establece LAB_JUDGE_PROVIDER=nim y el ID exacto del modelo de NVIDIA Build.
# IMPORTANTE: NIM remoto recibe fragmentos reales del dataset. Obtén consentimiento de los participantes.
# Usa LAB_JUDGE_REMOTE_CONSENT=YES únicamente tras autorizar explícitamente el envío externo.
LAB_JUDGE_PROVIDER=ollama
LAB_JUDGE_MODEL=gemma3:12b
NVIDIA_API_KEY=
LAB_JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
LAB_JUDGE_REMOTE_CONSENT=NO
LAB_OLLAMA_URL=http://127.0.0.1:11434
LAB_DATA_DIR=./data/lab
LAB_PEER_NAME=Interlocutor
# Búsqueda científica OpenAlex solo con --allow-web-papers

# Opcional: modelo local de instrucciones para router y revisión, separado del modelo de estilo.
REASONING_MODEL=

# direct: redacción directa. content_style: REASONING_MODEL decide el contenido y LLM_MODEL lo redacta.
# auto (recomendado con REASONING_MODEL): content_style solo cuando la búsqueda trae evidencia; direct si no.
REPLY_PIPELINE=direct

# Ejecutor local de entrenamiento (scripts/training-runner.mjs), opcional:
# TRAINING_PYTHON=.venv-lora/Scripts/python.exe
# TRAINING_ENGINE_URL=http://127.0.0.1:3000
# TRAINING_OLLAMA_URL=http://127.0.0.1:11434
# TRAINING_POLL_MS=5000
